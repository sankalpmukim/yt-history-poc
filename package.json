{
  "name": "yt-ledger",
  "displayName": "YT Ledger",
  "version": "0.9.0",
  "description": "An expense manager for your YouTube watch history — categorize what you watch, see where the time goes, budget it. Local-only.",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "qa:seed": "node scripts/create-qa-seed.mjs",
    "e2e": "pnpm exec playwright install chromium && pnpm build && playwright test",
    "e2e:headed": "pnpm exec playwright install chromium && pnpm build && HEADED=1 playwright test",
    "test": "rm -rf .test && esbuild core/*.test.ts utils/*.test.ts --bundle --platform=node --format=esm --outdir=.test && node --test .test/"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "^22.10.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.18.20",
    "typescript": "^5.5.0"
  },
  "manifest": {
    "permissions": [
      "storage",
      "scripting",
      "unlimitedStorage"
    ],
    "host_permissions": [
      "*://*.youtube.com/*"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "assets/fonts/BarlowCondensed-SemiBold.woff2",
          "assets/fonts/BarlowCondensed-Bold.woff2"
        ],
        "matches": [
          "*://*.youtube.com/*"
        ]
      }
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "lmdb",
      "msgpackr-extract",
      "core"
    ]
  }
}
