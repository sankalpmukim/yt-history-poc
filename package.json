{
  "name": "yt-ledger",
  "displayName": "YT Ledger",
  "version": "0.13.0",
  "description": "An expense manager for your YouTube watch history — categorize what you watch, see where the time goes, budget it. Local-only.",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "build:all": "plasmo build && plasmo build --target=firefox-mv3",
    "package": "plasmo package",
    "package:firefox": "plasmo package --target=firefox-mv3",
    "qa:seed": "node scripts/create-qa-seed.mjs",
    "e2e": "pnpm exec playwright install chromium && pnpm build:all && playwright test",
    "e2e:headed": "pnpm exec playwright install chromium && pnpm build:all && HEADED=1 playwright test",
    "e2e:firefox": "pnpm build:firefox && playwright test --project=\"firefox*\"",
    "test": "rm -rf .test && esbuild core/*.test.ts utils/*.test.ts --bundle --platform=node --format=esm --outdir=.test && node --test .test/"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "^22.10.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.18.20",
    "typescript": "^5.5.0"
  },
  "manifest": {
    "permissions": [
      "storage",
      "scripting",
      "unlimitedStorage"
    ],
    "host_permissions": [
      "*://*.youtube.com/*"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "assets/fonts/PublicSans-Variable.woff2",
          "assets/fonts/SourceSerif4-Variable.woff2"
        ],
        "matches": [
          "*://*.youtube.com/*"
        ]
      }
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "yt-ledger@sankalpmukim",
        "strict_min_version": "128.0",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "lmdb",
      "msgpackr-extract",
      "core"
    ]
  }
}
