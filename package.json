{
  "name": "yt-ledger",
  "displayName": "YT Ledger",
  "version": "0.4.0",
  "description": "An expense manager for your YouTube watch history — categorize what you watch, see where the time goes, budget it. Local-only.",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "rm -rf .test && esbuild core/*.test.ts --bundle --platform=node --format=esm --outdir=.test && node --test .test/"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "^22.10.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.18.20",
    "typescript": "^5.5.0"
  },
  "manifest": {
    "permissions": [
      "storage",
      "scripting",
      "unlimitedStorage"
    ],
    "host_permissions": [
      "*://*.youtube.com/*",
      "http://127.0.0.1:8742/*"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "lmdb",
      "msgpackr-extract",
      "core"
    ]
  }
}
